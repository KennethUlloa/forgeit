{
    "$src.forgeit.config.Config": {
        "ENGINE": {
            "$src.forgeit.engine.JinjaEngine": {}
        },
        "ENCODING": "utf-8",
        "TEMPLATES": {
            "flask:init": {
                "$src.forgeit.template.FolderTemplate": {
                    "id": "flask:init",
                    "name": "Flask base project",
                    "description": "Project structure for a Flask application",
                    "path": "./templates/flask",
                    "remove": "./templates/flask/",
                    "variables": {
                        "project": {
                            "name": {
                                "$str": null
                            },
                            "description": {
                                "$str": null
                            },
                            "author": {
                                "$str": null
                            },
                            "version": {
                                "$str": null
                            }
                        },
                        "module": {
                            "name": {
                                "$str": null
                            },
                            "plural_name": {
                                "$str": null
                            }
                        }
                    },
                    "processors": [
                        {
                            "$src.forgeit.processor.SnakeCase": [
                                "project.name",
                                "project.slug"
                            ]
                        },
                        {
                            "$src.forgeit.processor.SnakeCase": [
                                "module.name",
                                "module.slug"
                            ]
                        },
                        {
                            "$src.forgeit.processor.SnakeCase": [
                                "module.plural_name",
                                "module.plural_slug"
                            ]
                        },
                        {
                            "$src.forgeit.processor.PascalCase": [
                                "module.name",
                                "module.pascal_case"
                            ]
                        },
                        {
                            "$src.forgeit.processor.KebabCase": [
                                "module.name",
                                "module.pascal_url"
                            ]
                        }
                    ]
                }
            },
            "flask:mod": {
                "$src.forgeit.template.FolderTemplate": {
                    "id": "flask:mod",
                    "name": "Flask module",
                    "description": "Module structure for a Flask application",
                    "path": "./templates/flask",
                    "pattern": "{{project.slug}}/src/{{module.slug}}/**",
                    "remove": "./templates/flask/",
                    "variables": {
                        "project": {
                            "name": {
                                "$str": null
                            }
                        },
                        "module": {
                            "name": {
                                "$str": null
                            },
                            "plural_name": {
                                "$str": null
                            }
                        }
                    },
                    "processors": [
                        {
                            "$src.forgeit.processor.SnakeCase": [
                                "project.name",
                                "project.slug"
                            ]
                        },
                        {
                            "$src.forgeit.processor.SnakeCase": [
                                "module.name",
                                "module.slug"
                            ]
                        },
                        {
                            "$src.forgeit.processor.SnakeCase": [
                                "module.plural_name",
                                "module.plural_slug"
                            ]
                        },
                        {
                            "$src.forgeit.processor.PascalCase": [
                                "module.name",
                                "module.pascal_case"
                            ]
                        },
                        {
                            "$src.forgeit.processor.KebabCase": [
                                "module.plural_name",
                                "module.plural_url"
                            ]
                        }
                    ]
                }
            }
        }
    }
}